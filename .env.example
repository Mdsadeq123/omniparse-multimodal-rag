# Your OpenRouter API key (works with all NVIDIA Nemotron models on OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_TITLE=OmniParse

# Chat: NVIDIA Nemotron 3 Super (1M context, strong for RAG)
# Free tier — remove :free for paid ($0.09/M in, $0.45/M out)
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Embeddings: Llama Nemotron Embed VL (text + image retrieval)
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Vision captions for images (optional, set VISION_CAPTION_ENABLED=true)
VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
TOP_K=5
MAX_UPLOAD_MB=25
VISION_CAPTION_ENABLED=false
